# HTTP 代理。留空则直连。
PROXY_URL=

# 哪些计价的现货交易对算“有现货”，逗号分隔（如 USDT 或 USDT,USDC）。留空 = 任意计价都算。
SPOT_QUOTES=

# 每 5 分钟采样一次，这是相对 5 分钟整点的偏移秒数。150 = hh:02:30、hh:07:30……
# 取值 1–209：一次采样最多晚 90 秒写完，这段时间不能跨过 5 分钟收盘。
SAMPLE_OFFSET_SECONDS=150

# duckport status 用现在减去水位和这个秒数比较。水位每次采样成功都会推进。
WATERMARK_MAX_LAG_SECONDS=900
